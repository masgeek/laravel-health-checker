{
  "name": "masgeek/laravel-health-checker",
  "description": "Laravel health checker helper",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Masgeek\\HealthCheck\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Masgeek\\HealthCheck\\HealthCheckServiceProvider"
      ]
    }
  },
  "authors": [
    {
      "name": "Munywele Sammy Barasa",
      "email": "sammy@munywele.co.ke"
    }
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "require": {
    "php": "^8.2|| ^8.3 || ^8.4 || ^8.5",
    "illuminate/cache": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/filesystem": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/log": "^12.0 || ^13.0",
    "illuminate/mail": "^12.0 || ^13.0",
    "illuminate/queue": "^12.0 || ^13.0",
    "illuminate/redis": "^12.0 || ^13.0",
    "illuminate/routing": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "guzzlehttp/guzzle": "^7.8 || ^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "orchestra/testbench": "^10.0 || ^11.0",
    "pestphp/pest": "^3.0",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/php-cs-fixer fix",
    "lint": "vendor/bin/php-cs-fixer check --diff",
    "test-b": "vendor/bin/pest --configuration phpunit.xml",
    "test": "vendor/bin/pest"
  }
}
